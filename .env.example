# Application Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL + Sequelize)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=janvi
DB_PASSWORD=your_password
DB_DATABASE=eventhub_db
DB_SYNC=true
DB_LOGGING=false

# Authentication Configuration (Access Token Only)
JWT_SECRET=super-secret-jwt-key-eventhub-2026
JWT_EXPIRATION=24h

# OTP Configuration (Email-less / Frontend Delivery)
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=5

# RabbitMQ Configuration
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
